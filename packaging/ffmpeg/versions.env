# Pinned upstream sources for the SubRec minimal FFmpeg build (the gpl variant was built once).
#
# Every ref/commit below was verified EXTERNALLY by a maintainer with `git ls-remote` on
# 2026-10-26 (not from the environment that wrote these scripts). build-ffmpeg.sh refuses to
# build if a checkout does not resolve to the commit pinned here.
#
# Plain KEY=value lines only (sourced by bash). No inline comments after values.

# --- FFmpeg ---------------------------------------------------------------------------
# n8.0.3: same library majors as the DLLs SubRec was developed against
# (avutil-60, avcodec-62, avformat-62, avfilter-11, avdevice-62, swscale-9, swresample-6).
# Tag object of n8.0.3: 3b9813e76f3d2a6663de825ccebbef3968d7a576
FFMPEG_REPO=https://git.ffmpeg.org/ffmpeg.git
FFMPEG_REF=n8.0.3
FFMPEG_COMMIT=8ae0b34901ba60a802f183ee75a250a9fc3e09a5
# Alternatives (externally verified, NOT selected; see README.md "FFmpeg version"):
#   n8.1.3 commit 1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7
#   n8.1   commit 9047fa1b084f76b1b4d065af2d743df1b40dfb56
# If you switch, update EXPECTED_DLLS after checking libav*/version_major.h of that tag.
EXPECTED_DLLS="avutil-60.dll avcodec-62.dll avformat-62.dll avfilter-11.dll avdevice-62.dll swscale-9.dll swresample-6.dll"

# All *_COMMIT values must be commit ids, never annotated tag objects: build-ffmpeg.sh
# compares them with `git rev-parse HEAD` and stops on any mismatch. Confirmed commits:
# FFmpeg, nv-codec-headers, x264 (branch head), AMF (lightweight tag). NOT yet confirmed as
# commit-vs-tag-object: LIBVPL and OPENH264 (check with `git rev-parse <tag>^{commit}`).

# --- x264 (GPL-2.0-or-later; only in the "gpl" variant) -----------------------------
# stable branch head on 2026-10-26; x264.h defines X264_BUILD 165 (checked externally).
X264_REPO=https://code.videolan.org/videolan/x264.git
X264_REF=stable
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

# --- nv-codec-headers (MIT) -----------------------------------------------------------
# n12.2.72.0 chosen for wider NVIDIA driver compatibility than n13.x (see README.md).
# Commit verified externally by git clone. (157becbf51c8b813425572b75c06c370bd43d8fd is the
# annotated tag object, NOT the commit.)
NVCODEC_REPO=https://git.videolan.org/git/ffmpeg/nv-codec-headers.git
NVCODEC_REF=n12.2.72.0
NVCODEC_COMMIT=c69278340ab1d5559c7d7bf0edf615dc33ddbba7
# Alternatives (externally verified, NOT selected):
#   n13.0.19.1 commit 88fee5c37318c991a8762d423530f91681e32e3a
#   n13.1.15.0 commit 0a6fba9a2820628b8103464f4c8753ee05838baa

# --- AMD AMF headers (MIT) ------------------------------------------------------------
# Only amf/public/include is used (header-only; the runtime comes with the AMD driver).
AMF_REPO=https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git
AMF_REF=v1.5.3
AMF_COMMIT=57ee0cfb0e1a08d9041f77435653794c1b012be0

# --- Intel libvpl dispatcher (MIT), linked statically for h264_qsv ---------------------
LIBVPL_REPO=https://github.com/intel/libvpl.git
LIBVPL_REF=v2.16.0
LIBVPL_COMMIT=778a66d6c6537f08eabb91955dbbf1bce3812894
# Alternative (externally verified, NOT selected): v2.17.0 d77f9195cf495b937631607333288fd917ae8939

# --- OpenH264 (BSD-2-Clause; only in the optional "lgpl-openh264" variant) --------------
OPENH264_REPO=https://github.com/cisco/openh264.git
OPENH264_REF=v2.7.0
OPENH264_COMMIT=1bca62311e447fd9c39fc93de2c4b96cd5ce971c
