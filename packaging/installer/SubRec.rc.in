#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/installer/SubRec.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SUBREC_VERSION_RESOURCE@
 PRODUCTVERSION @SUBREC_VERSION_RESOURCE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SubRec\0"
            VALUE "FileDescription", "SubRec screen recorder\0"
            VALUE "FileVersion", "@SUBREC_VERSION@\0"
            VALUE "InternalName", "appSubRec\0"
            VALUE "OriginalFilename", "appSubRec.exe\0"
            VALUE "ProductName", "SubRec\0"
            VALUE "ProductVersion", "@SUBREC_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
